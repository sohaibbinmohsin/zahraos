# .env — platform, hosted Supabase Cloud project
#
# Copy this file to .env and fill in real values. .env is git-ignored (see
# .gitignore) — never commit real secrets.
#
# This project must be a SEPARATE Supabase project from vms/backend's — see
# platform-design.md §2 ("Module = separate project"). Do not point this at
# the same project as youth-republic/backend/.env.

# --- Supabase Cloud project (Settings > API in the Supabase dashboard) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Direct Postgres connection (Settings > Database > Connection string,
# "URI" format) — used to run pgTAP test files directly via psql, since
# there's no local Docker stack to run `supabase test db` against. ---
SUPABASE_DB_URL=

# --- Supabase CLI auth, for `supabase link` / `supabase db push` against
# this hosted project instead of a local one ---
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=

# --- Shared cross-project secret ---
# MUST be the exact same value as STAFF_JWT_SECRET in
# youth-republic/backend/.env — this project mints staff tokens with it,
# vms/backend verifies them with it. A mismatch fails every staff-
# authenticated call silently until checked (platform-backend plan
# post-plan checklist already flags this).
STAFF_JWT_SECRET=

# --- vms/backend's hosted Edge Functions base URL ---
# e.g. https://<vms-project-ref>.supabase.co/functions/v1
# Used by enable-module/update-organization to push org data via
# sync-organization (platform-backend plan Task 15).
VMS_BACKEND_FUNCTIONS_URL=

# --- Next.js (platform-frontend-shell plan Task 1) ---
# Browser-exposed — same project as SUPABASE_URL/SUPABASE_ANON_KEY above,
# just under the NEXT_PUBLIC_ prefix Next.js requires for client-side use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_FUNCTIONS_URL=
NEXT_PUBLIC_VMS_FUNCTIONS_URL=
